// Hand-written escape hatch for the externs generator (tools/bindgen).
//
// The generator maps most C++ types by rule (see tools/bindgen/types.zig).
// Types it cannot map with certainty - by-value structs, mostly - make the
// functions using them "not generated" and are listed at the end of
// src/externs.gen.zig. Add an entry here to enable them.
.{
    // Zig declarations copied verbatim into the generated `support` namespace.
    // Keep them ABI-identical to the C++ definitions named in the comments.
    .decls = .{
        // binding/support.h: struct two_pointers_t { void* a; void* b; }
        "pub const TwoPointers = extern struct { a: ?*anyopaque, b: ?*anyopaque };",
        // binding/support.h: struct memory_span_t { uint8_t* data; size_t size; }
        "pub const MemorySpan = extern struct { data: ?[*]u8, size: usize };",
        // v8-script.h: struct StartupData { const char* data; int raw_size; }
        "pub const StartupData = extern struct { data: ?[*]const u8, raw_size: c_int };",
    },

    // C++ spelling (exactly as clang prints it) -> Zig type expression.
    .types = .{
        // binding/support.h: enum class MaybeBool { JustFalse, JustTrue, Nothing }.
        // v8.zig has the ABI-identical enum, with helpers; reuse it.
        .{ .cpp = "MaybeBool", .zig = "v8.support.MaybeBool" },
        .{ .cpp = "two_pointers_t", .zig = "support.TwoPointers" },
        .{ .cpp = "memory_span_t", .zig = "support.MemorySpan" },
        .{ .cpp = "v8::StartupData", .zig = "support.StartupData" },
        // Out-parameters filled by the shim; support.Maybe is `extern struct { has_value, value }`.
        .{ .cpp = "v8::Maybe<bool> *", .zig = "*v8.support.Maybe(bool)" },
        .{ .cpp = "v8::Maybe<double> *", .zig = "*v8.support.Maybe(f64)" },
        .{ .cpp = "v8::Maybe<int32_t> *", .zig = "*v8.support.Maybe(i32)" },
        .{ .cpp = "v8::Maybe<int64_t> *", .zig = "*v8.support.Maybe(i64)" },
        .{ .cpp = "v8::Maybe<uint32_t> *", .zig = "*v8.support.Maybe(u32)" },
        .{ .cpp = "v8::Maybe<v8::PropertyAttribute> *", .zig = "*v8.support.Maybe(v8.PropertyAttribute)" },

        // v8.zig keeps some enums nested in the wrapper that uses them.
        .{ .cpp = "v8::NewStringType", .zig = "Named(\"String_NewStringType\", i32)" },
    },
}
