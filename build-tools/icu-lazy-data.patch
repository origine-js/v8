+// Borrows path/error storage until return. Returns cached ICU-owned UDataMemory
+// valid until ICU cleanup; its embedded bytes remain provider-owned until exit.
+// Failure returns null, retaining any previously cached packages. Invokes the
+// provider outside ICU's cache mutex; concurrent first calls may block there.
 static UDataMemory *
 openCommonData(const char *path,          /*  Path from OpenChoice?          */
                int32_t commonDataIndex,   /*  ICU Data (index >= 0) if path == nullptr */
@@ -677,6 +696,20 @@
 
     if (U_FAILURE(*pErrorCode)) {
         return nullptr;
+    }
+
+    // Defer package expansion until a real common-data request. Do this before
+    // entering the ICU cache lock because registration takes that lock itself.
+    if (commonDataIndex == 0) {
+        V8ZigICUDataProvider provider =
+            gV8ZigDataProvider.load(std::memory_order_acquire);
+        if (provider != nullptr) {
+            UErrorCode status = provider();
+            if (U_FAILURE(status)) {
+                *pErrorCode = status;
+                return nullptr;
+            }
+        }
     }
 
