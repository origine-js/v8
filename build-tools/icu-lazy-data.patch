+// zig-v8: provider code must remain alive until process exit. The callback
+// returns a copied ICU status, supports concurrent first calls, and must not
+// reenter common-data lookup. It retains published immutable data until exit.
+using V8ZigICUDataProvider = UErrorCode (*)();
+static std::atomic<V8ZigICUDataProvider> gV8ZigDataProvider{nullptr};
+
+// Borrows no storage; retains only provider code until process exit. Register
+// before ICU use. Atomic publication supports concurrent lookups. A null
+// provider preserves ICU's stock linked-data behavior (used by mksnapshot).
+extern "C" void v8_zig_icu_set_data_provider(V8ZigICUDataProvider provider) {
+    gV8ZigDataProvider.store(provider, std::memory_order_release);
+}
