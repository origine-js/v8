+// zig-v8: retain original public builtin functions in a context-owned table.
+// The table is traced and serialized with NativeContext, never exposed to JS.
+// A builtin used for distinct function objects is ambiguous: fail closed.
+void RetainZigIntrinsic(Isolate* isolate, Builtin builtin,
+                        DirectHandle<JSFunction> function) {
+  Tagged<FixedArray> table = isolate->native_context()->zig_intrinsic_functions();
+  int index = static_cast<int>(builtin);
+  Tagged<Object> previous = table->get(index);
+  if (IsTheHole(previous, isolate)) {
+    table->set(index, *function);
+  } else if (previous != *function) {
+    table->set(index, ReadOnlyRoots(isolate).undefined_value());
+  }
+}
