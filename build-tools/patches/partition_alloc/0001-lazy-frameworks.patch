diff --git a/src/partition_alloc/partition_alloc_base/time/time_apple.cc b/src/partition_alloc/partition_alloc_base/time/time_apple.cc
new file mode 100644
index 00000000..08758e71
--- /dev/null
+++ b/src/partition_alloc/partition_alloc_base/time/time_apple.cc
@@ -0,0 +1,3 @@
+// Compile common macOS clocks without emitting unused ObjC image metadata.
+// NSDate bridges live in a separate archive member, pulled only by NSDate users.
+#include "partition_alloc/partition_alloc_base/time/time_apple.mm"
diff --git a/src/partition_alloc/partition_alloc_base/time/time_apple_nsdate.mm b/src/partition_alloc/partition_alloc_base/time/time_apple_nsdate.mm
new file mode 100644
index 00000000..6a9214de
--- /dev/null
+++ b/src/partition_alloc/partition_alloc_base/time/time_apple_nsdate.mm
@@ -0,0 +1,18 @@
+#include "partition_alloc/partition_alloc_base/time/time.h"
+#import <Foundation/Foundation.h>
+
+namespace partition_alloc::internal::base {
+
+// Borrows date through return; returns a copied time and retains no input object.
+Time Time::FromNSDate(NSDate* date) {
+  PA_BASE_DCHECK(date);
+  return FromCFAbsoluteTime(date.timeIntervalSinceReferenceDate);
+}
+
+// Borrows this through return; returns an autoreleased NSDate valid until the
+// current autorelease pool drains. Caller retains it to extend that lifetime.
+NSDate* Time::ToNSDate() const {
+  return [NSDate dateWithTimeIntervalSinceReferenceDate:ToCFAbsoluteTime()];
+}
+
+}  // namespace partition_alloc::internal::base
