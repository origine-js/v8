+// Borrows isolate/context on the isolate thread with a live HandleScope. Roots
+// all temporary handles across GC; commits the context-owned, serialized graph
+// only on success. Failure leaves an unexposed partially finalized context for
+// GC, never a context usable by the caller. No JS getters or constructors run.
+bool FinalizeZigIntrinsics(Isolate* isolate,
+                           DirectHandle<NativeContext> context) {
+  SaveContext saved_context(isolate);
+  isolate->set_context(*context);
+  DirectHandle<JSGlobalObject> global(context->global_object(), isolate);
+  // SharedArrayBuffer and Atomics stay available; blocking waits are governed
+  // independently by the isolate's allow_atomics_wait setting.
+  for (const char* name : {"WebAssembly", "ShadowRealm"}) {
+    DirectHandle<String> key = isolate->factory()->InternalizeUtf8String(name);
+    if (!JSReceiver::DeleteProperty(isolate, global, key, LanguageMode::kStrict)
+             .FromMaybe(false)) return false;
+  }
+
+  std::vector<Handle<JSObject>> graph;
+  // Borrows a tagged value until return; retains ordinary intrinsic objects in
+  // GC-rooted handles for this call. Does not retain globals or internal tables.
+  auto add = [&](Tagged<Object> value) {
+    if (!IsJSObject(value) || IsJSGlobalObject(value) ||
+        IsJSGlobalProxy(value)) return;
+    Tagged<JSObject> object = Cast<JSObject>(value);
+    for (auto prior : graph) {
+      if (*prior == object) return;
+    }
+    graph.push_back(handle(object, isolate));
+  };
+
+  // Context slots provide hidden prototypes (including Segments and
+  // SegmentIterator) directly, without allocating guest-visible instances.
+#define ZIG_INTRINSIC_ROOT(index, type, name)                               \
+  {                                                                         \
+    Tagged<Object> value = context->GetNoCell(Context::index);              \
+    if (std::string_view(#type) == "Map" && IsMap(value)) {                 \
+      add(Cast<Map>(value)->prototype());                                   \
+    } else if ((std::string_view(#type) == "JSObject" ||                    \
+                std::string_view(#type) == "JSFunction") &&                 \
+               Context::index != Context::EXTRAS_BINDING_OBJECT_INDEX &&    \
+               Context::index != Context::GLOBAL_PROXY_FUNCTION_INDEX) {    \
+      add(value);                                                           \
+    }                                                                       \
+  }
+  NATIVE_CONTEXT_FIELDS(ZIG_INTRINSIC_ROOT)
+#undef ZIG_INTRINSIC_ROOT
+
+  // Explicit ECMAScript binding inventory: application and host globals stay
+  // extensible and are never traversed merely because they are on the global.
+  constexpr const char* bindings[] = {
+      "globalThis", "Infinity", "NaN", "undefined", "eval", "isFinite", "isNaN",
+      "parseFloat", "parseInt", "decodeURI", "decodeURIComponent", "encodeURI",
+      "encodeURIComponent", "escape", "unescape", "Object", "Function",
+      "Boolean", "Symbol", "Error", "AggregateError", "EvalError", "RangeError",
+      "ReferenceError", "SyntaxError", "TypeError", "URIError", "Number",
+      "BigInt", "Math", "Date", "String", "RegExp", "Array", "Int8Array",
+      "Uint8Array", "Uint8ClampedArray", "Int16Array", "Uint16Array", "Int32Array",
+      "Uint32Array", "BigInt64Array", "BigUint64Array", "Float16Array",
+      "Float32Array", "Float64Array", "Map", "Set", "WeakMap", "WeakSet",
+      "ArrayBuffer", "SharedArrayBuffer", "Atomics", "DataView", "JSON", "Promise", "Proxy", "Reflect", "Intl",
+      "WeakRef", "FinalizationRegistry", "Iterator", "AsyncIterator",
+      "DisposableStack", "AsyncDisposableStack", "SuppressedError", "Temporal"};
+  std::vector<Handle<String>> installed;
+  for (const char* name : bindings) {
+    Handle<String> key = isolate->factory()->InternalizeUtf8String(name);
+    LookupIterator it(isolate, global, key, LookupIterator::OWN_SKIP_INTERCEPTOR);
+    if (it.state() == LookupIterator::NOT_FOUND) continue;
+    // All builtin global bindings must be data properties by finalization.
+    if (it.state() != LookupIterator::DATA) return false;
+    installed.push_back(key);
+    add(*it.GetDataValue());
+  }
+
+  // Read data and accessor-pair fields directly: descriptor materialization
+  // would invoke native AccessorInfo getters, including lazy properties.
+  for (size_t index = 0; index < graph.size(); ++index) {
+    Handle<JSObject> object = graph[index];
+    add(object->map()->prototype());
+    if (IsJSFunction(*object)) {
+      Tagged<JSFunction> function = Cast<JSFunction>(*object);
+      if (function->has_prototype_slot() && function->has_instance_prototype()) {
+        add(function->instance_prototype());
+      }
+    }
+    DirectHandle<FixedArray> keys;
+    if (!JSReceiver::OwnPropertyKeys(isolate, object).ToHandle(&keys)) return false;
+    for (int k = 0; k < static_cast<int>(keys->length().value()); ++k) {
+      DirectHandle<Object> key(keys->get(k), isolate);
+      LookupIterator it(isolate, object, PropertyKey(isolate, key),
+                        LookupIterator::OWN_SKIP_INTERCEPTOR);
+      if (it.state() == LookupIterator::DATA) {
+        add(*it.GetDataValue());
+      } else if (it.state() == LookupIterator::ACCESSOR) {
+        DirectHandle<Object> accessors = it.GetAccessors();
+        if (IsAccessorPair(*accessors)) {
+          auto pair = Cast<AccessorPair>(accessors);
+          add(pair->getter());
+          add(pair->setter());
+        }
+      }
+    }
+  }
+  for (auto object : graph) {
+    if (!JSReceiver::SetIntegrityLevel(isolate, object, FROZEN, kThrowOnError)
+             .FromMaybe(false)) return false;
+  }
+  for (auto key : installed) {
+    PropertyDescriptor desc;
+    desc.set_writable(false);
+    desc.set_configurable(false);
+    if (!JSReceiver::DefineOwnProperty(isolate, global, key, &desc,
+                                       Just(kThrowOnError)).FromMaybe(false)) {
+      return false;
+    }
+  }
+  Handle<FixedArray> inventory = isolate->factory()->NewFixedArray(
+      static_cast<int>(graph.size()), AllocationType::kOld);
+  for (size_t i = 0; i < graph.size(); ++i) {
+    inventory->set(static_cast<int>(i), *graph[i]);
+  }
+  context->set_zig_intrinsic_objects(*inventory);
+  return true;
+}
