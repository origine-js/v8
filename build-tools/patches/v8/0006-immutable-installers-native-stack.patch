+// Borrows this context through return. Copies a native limit; retains no host
+// resources. Requires its isolate entered and a live HandleScope. No JS runs.
+void Context::SetStackTraceLimit(int limit) {
+  CHECK_GE(limit, -1);
+  auto context = Utils::OpenDirectHandle(this);
+  i::Isolate* isolate = i::Isolate::Current();
+  i::HandleScope scope(isolate);
+  context->native_context()->set_zig_stack_trace_limit(
+      *isolate->factory()->NewNumberFromInt(limit));
+}
+
+// Returns a value; retains no resources. Owning isolate/HandleScope must be live.
+int Context::GetStackTraceLimit() {
+  auto context = Utils::OpenDirectHandle(this);
+  return static_cast<int>(i::Object::NumberValue(
+      context->native_context()->zig_stack_trace_limit()));
+}
+
 void Context::Enter() {
   i::DisallowGarbageCollection no_gc;
   i::Tagged<i::NativeContext> env = *Utils::OpenDirectHandle(this);
