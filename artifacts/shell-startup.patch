new file mode 100644
index 0000000..4c935f9
--- /dev/null
+++ b/build-tools/bundle-archives.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+# Borrows the executable/input paths through this process; creates a build-owned
+# output archive, flattening members so consumers need only -lv8_zig. Inputs are
+# unchanged; on archiver failure the build owns any partially generated output.
+set -eu
+zig=$1
+output=$2
+shift 2
+{
+    printf 'CREATE "%s"\n' "$output"
+    for archive do
+        printf 'ADDLIB "%s"\n' "$archive"
+    done
+    printf 'SAVE\nEND\n'
+} | "$zig" ar -M
diff --git a/build-tools/compare-startup.py b/build-tools/compare-startup.py
new file mode 100644
index 0000000..36295ed
--- /dev/null
+++ b/build-tools/compare-startup.py
@@ -0,0 +1,65 @@
+# /// script
+# requires-python = ">=3.11"
+# dependencies = ["typer>=0.12"]
+# ///
+"""Compare full process lifetime in interleaved batches separated by a pause."""
+import json
+import os
+from pathlib import Path
+import random
+import statistics
+import subprocess
+import time
+
+import typer
+
+
+# Borrows paths/options through return; owns and waits for every child and its
+# pipes. Owns samples locally; the caller owns the written JSON. Failures close
+# pipes and leave no running child. Warmups are excluded from results.
+def main(baseline: Path, candidate: Path, runs: int = 150,
+         output: Path = Path("zig-out/startup-comparison.json")) -> None:
+    if runs < 150:
+        raise typer.BadParameter("use at least 150 runs per binary per batch")
+    env = dict(os.environ)
+    env.pop("V8_STARTUP_TRACE", None)
+    binaries = {"baseline": str(baseline.resolve()), "candidate": str(candidate.resolve())}
+    batches = []
+    rng = random.Random(20261014)
+    for batch in range(2):
+        if batch:
+            typer.echo("Waiting 5 seconds before the second batch...")
+            time.sleep(5)
+        for _ in range(5):
+            for binary in binaries.values():
+                subprocess.run([binary], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                               stderr=subprocess.PIPE, env=env, check=True)
+        samples = {name: [] for name in binaries}
+        for _ in range(runs):
+            order = list(binaries)
+            rng.shuffle(order)
+            for name in order:
+                start = time.perf_counter_ns()
+                subprocess.run([binaries[name]], stdin=subprocess.DEVNULL,
+                               stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
+                               env=env, check=True)
+                samples[name].append(time.perf_counter_ns() - start)
+        summary = {name: {"median_ns": statistics.median(values),
+                          "mean_ns": statistics.mean(values),
+                          "stdev_ns": statistics.stdev(values)}
+                   for name, values in samples.items()}
+        saving = summary["baseline"]["median_ns"] - summary["candidate"]["median_ns"]
+        batches.append({"batch": batch + 1, "summary": summary, "saving_median_ns": saving,
+                        "samples_ns": samples})
+        typer.echo(f"Batch {batch + 1}: {runs} runs per binary")
+        for name, values in summary.items():
+            typer.echo(f"  {name}: median {values['median_ns']/1e6:.3f} ms, "
+                       f"mean {values['mean_ns']/1e6:.3f} ± {values['stdev_ns']/1e6:.3f} ms")
+        typer.echo(f"  Candidate median saving: {saving/1e6:+.3f} ms")
+    output.write_text(json.dumps({"binaries": binaries, "runs_per_batch": runs,
+                                  "pause_seconds": 5, "batches": batches}, indent=2) + "\n")
+    typer.echo(f"Raw results: {output}")
+
+
+if __name__ == "__main__":
+    typer.run(main)
diff --git a/build-tools/compress-icu.py b/build-tools/compress-icu.py
new file mode 100644
index 0000000..9bcfe94
--- /dev/null
+++ b/build-tools/compress-icu.py
@@ -0,0 +1,37 @@
+# /// script
+# requires-python = ">=3.11"
+# dependencies = ["typer>=0.12,<1", "zstandard==0.25.0"]
+# ///
+"""Embed the complete ICU package as a deterministic zstd frame."""
+from pathlib import Path
+import zstandard
+
+import typer
+
+
+# Borrows paths through return; owns temporary bytes locally. Writes build-owned
+# generated source only when contents change; failures retain no open files.
+def main(source: Path, output: Path) -> None:
+    original = source.read_bytes()
+    compressed = zstandard.ZstdCompressor(level=19, write_checksum=True).compress(original)
+    if zstandard.ZstdDecompressor().decompress(compressed) != original:
+        raise RuntimeError("ICU zstd round-trip mismatch")
+    lines = ["// Generated by compress-icu.py; do not edit.",
+             "#include <cstddef>",
+             'extern "C" {',
+             "extern const unsigned char v8_zig_icu_compressed[] = {"]
+    for offset in range(0, len(compressed), 24):
+        lines.append(",".join(str(value) for value in compressed[offset:offset + 24]) + ",")
+    lines.extend(["};",
+                  f"extern const size_t v8_zig_icu_compressed_size = {len(compressed)};",
+                  f"extern const size_t v8_zig_icu_original_size = {len(original)};",
+                  "}", ""])
+    contents = "\n".join(lines)
+    if not output.exists() or output.read_text() != contents:
+        output.write_text(contents)
+    typer.echo(f"ICU data: {len(original):,} -> {len(compressed):,} bytes "
+               f"({100 * len(compressed) / len(original):.1f}%)")
+
+
+if __name__ == "__main__":
+    typer.run(main)
