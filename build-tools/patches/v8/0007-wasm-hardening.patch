+// Borrows the completed context on its isolate thread with a live HandleScope.
+// Seals the WebAssembly namespace graph (constructors, prototypes, JS-API
+// helpers) installed by WasmJs::Install; retains no resources. Failure leaves an
+// unexposed partial context for GC. Without Wasm support it accepts and returns.
+bool CompleteZigWasmIntrinsics(Isolate* isolate, DirectHandle<NativeContext> context) {
+#if V8_ENABLE_WEBASSEMBLY
+  // The preallocated namespace object lives in the native context whether or not
+  // it is exposed on the global (custom snapshots never expose it).
+  if (!SealZigIntrinsicFamily(isolate, context->wasm_webassembly_object())) {
+    return false;
+  }
+#endif
+  return true;
+}
