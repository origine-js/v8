+    //     const input = std.mem.trim(u8, line, " \r\t");
+    //     if (std.mem.eql(u8, input, "exit()")) break;
+    //     if (std.mem.eql(u8, input, ":a")) {
+    //         current = a;
+    //         continue;
+    //     }
+    //     if (std.mem.eql(u8, input, ":b")) {
+    //         current = b;
