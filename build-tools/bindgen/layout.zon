// Source of truth for the C++ layout facts the Zig side depends on.
//
// `zig build gen` measures these with V8's own clang (using the exact flags of
// binding.cc) and regenerates:
//   * src/generated/binding.zig         - the constants Zig reads
//   * binding/layout.gen.h    - static_asserts so a V8 upgrade breaks the C++
//                               build loudly instead of corrupting memory
.{
    // Headers needed to name the types below.
    .includes = .{
        "v8.h",
        "v8-fast-api-calls.h",
        "v8-cppgc.h",
        "cppgc/heap.h",
    },

    // sizeof(cpp) -> binding.sizes.<name>
    .sizes = .{
        .{ .name = "HeapSpaceStatistics", .cpp = "v8::HeapSpaceStatistics" },
        .{ .name = "String_ValueView", .cpp = "v8::String::ValueView" },
        .{ .name = "SnapshotCreator", .cpp = "v8::SnapshotCreator" },
        .{ .name = "Eternal_Data", .cpp = "v8::Eternal<v8::Data>" },
        .{ .name = "TracedReference_Data", .cpp = "v8::TracedReference<v8::Data>" },
        .{ .name = "Isolate_AllowJavascriptExecutionScope", .cpp = "v8::Isolate::AllowJavascriptExecutionScope" },
        .{ .name = "Isolate_DisallowJavascriptExecutionScope", .cpp = "v8::Isolate::DisallowJavascriptExecutionScope" },
        .{ .name = "Isolate_CreateParams", .cpp = "v8::Isolate::CreateParams" },
        .{ .name = "HandleScope", .cpp = "v8::HandleScope" },
        .{ .name = "TryCatch", .cpp = "v8::TryCatch" },
        .{ .name = "ScriptOrigin", .cpp = "v8::ScriptOrigin" },
        .{ .name = "ScriptCompiler_Source", .cpp = "v8::ScriptCompiler::Source" },
        .{ .name = "PromiseRejectMessage", .cpp = "v8::PromiseRejectMessage" },
        .{ .name = "FunctionCallbackInfo", .cpp = "v8::FunctionCallbackInfo<v8::Value>" },
        .{ .name = "PropertyCallbackInfo", .cpp = "v8::PropertyCallbackInfo<v8::Value>" },
        .{ .name = "ReturnValue", .cpp = "v8::ReturnValue<v8::Value>" },
        .{ .name = "Location", .cpp = "v8::Location" },
        .{ .name = "StartupData", .cpp = "v8::StartupData" },
        .{ .name = "PropertyDescriptor", .cpp = "v8::PropertyDescriptor" },
        .{ .name = "ResourceConstraints", .cpp = "v8::ResourceConstraints" },
        .{ .name = "HeapStatistics", .cpp = "v8::HeapStatistics" },
        .{ .name = "CFunction", .cpp = "v8::CFunction" },
        .{ .name = "CTypeInfo", .cpp = "v8::CTypeInfo" },
    },

    // Integral constant expressions -> binding.consts.<name>.
    // Private members are fine: the shim target is built with -fno-access-control
    // (build-tools/BUILD.gn), and the probe reuses those exact flags.
    .consts = .{
        .{ .name = "FunctionCallbackInfo_kArgsLength", .expr = "v8::FunctionCallbackInfo<v8::Value>::kArgsLength" },

        // Flag and enum values: v8/flag_abi.zig compares each Zig type bit for bit against these.
        .{ .name = "PropertyAttribute_None", .expr = "v8::PropertyAttribute::None" },
        .{ .name = "PropertyAttribute_ReadOnly", .expr = "v8::PropertyAttribute::ReadOnly" },
        .{ .name = "PropertyAttribute_DontEnum", .expr = "v8::PropertyAttribute::DontEnum" },
        .{ .name = "PropertyAttribute_DontDelete", .expr = "v8::PropertyAttribute::DontDelete" },
        .{ .name = "PropertyFilter_ALL_PROPERTIES", .expr = "v8::ALL_PROPERTIES" },
        .{ .name = "PropertyFilter_ONLY_WRITABLE", .expr = "v8::ONLY_WRITABLE" },
        .{ .name = "PropertyFilter_ONLY_ENUMERABLE", .expr = "v8::ONLY_ENUMERABLE" },
        .{ .name = "PropertyFilter_ONLY_CONFIGURABLE", .expr = "v8::ONLY_CONFIGURABLE" },
        .{ .name = "PropertyFilter_SKIP_STRINGS", .expr = "v8::SKIP_STRINGS" },
        .{ .name = "PropertyFilter_SKIP_SYMBOLS", .expr = "v8::SKIP_SYMBOLS" },
        .{ .name = "KeyCollectionMode_kOwnOnly", .expr = "v8::KeyCollectionMode::kOwnOnly" },
        .{ .name = "KeyCollectionMode_kIncludePrototypes", .expr = "v8::KeyCollectionMode::kIncludePrototypes" },
        .{ .name = "IndexFilter_kIncludeIndices", .expr = "v8::IndexFilter::kIncludeIndices" },
        .{ .name = "IndexFilter_kSkipIndices", .expr = "v8::IndexFilter::kSkipIndices" },
        .{ .name = "KeyConversionMode_kConvertToString", .expr = "v8::KeyConversionMode::kConvertToString" },
        .{ .name = "KeyConversionMode_kKeepNumbers", .expr = "v8::KeyConversionMode::kKeepNumbers" },
        .{ .name = "KeyConversionMode_kNoNumbers", .expr = "v8::KeyConversionMode::kNoNumbers" },
        .{ .name = "IntegrityLevel_kFrozen", .expr = "v8::IntegrityLevel::kFrozen" },
        .{ .name = "IntegrityLevel_kSealed", .expr = "v8::IntegrityLevel::kSealed" },
        .{ .name = "MemoryPressureLevel_kNone", .expr = "v8::MemoryPressureLevel::kNone" },
        .{ .name = "MemoryPressureLevel_kModerate", .expr = "v8::MemoryPressureLevel::kModerate" },
        .{ .name = "MemoryPressureLevel_kCritical", .expr = "v8::MemoryPressureLevel::kCritical" },
        .{ .name = "PropertyHandlerFlags_kNone", .expr = "v8::PropertyHandlerFlags::kNone" },
        .{ .name = "PropertyHandlerFlags_kNonMasking", .expr = "v8::PropertyHandlerFlags::kNonMasking" },
        .{ .name = "PropertyHandlerFlags_kOnlyInterceptStrings", .expr = "v8::PropertyHandlerFlags::kOnlyInterceptStrings" },
        .{ .name = "PropertyHandlerFlags_kHasNoSideEffect", .expr = "v8::PropertyHandlerFlags::kHasNoSideEffect" },
        .{ .name = "PropertyHandlerFlags_kHasDontDeleteProperty", .expr = "v8::PropertyHandlerFlags::kHasDontDeleteProperty" },
        .{ .name = "PropertyHandlerFlags_kInternalNewCallbacksSignatures", .expr = "v8::PropertyHandlerFlags::kInternalNewCallbacksSignatures" },
        .{ .name = "String_WriteFlags_kNone", .expr = "v8::String::WriteFlags::kNone" },
        .{ .name = "String_WriteFlags_kNullTerminate", .expr = "v8::String::WriteFlags::kNullTerminate" },
        .{ .name = "String_WriteFlags_kReplaceInvalidUtf8", .expr = "v8::String::WriteFlags::kReplaceInvalidUtf8" },
        .{ .name = "RegExp_Flags_kNone", .expr = "v8::RegExp::kNone" },
        .{ .name = "RegExp_Flags_kGlobal", .expr = "v8::RegExp::kGlobal" },
        .{ .name = "RegExp_Flags_kIgnoreCase", .expr = "v8::RegExp::kIgnoreCase" },
        .{ .name = "RegExp_Flags_kMultiline", .expr = "v8::RegExp::kMultiline" },
        .{ .name = "RegExp_Flags_kSticky", .expr = "v8::RegExp::kSticky" },
        .{ .name = "RegExp_Flags_kUnicode", .expr = "v8::RegExp::kUnicode" },
        .{ .name = "RegExp_Flags_kDotAll", .expr = "v8::RegExp::kDotAll" },
        .{ .name = "RegExp_Flags_kLinear", .expr = "v8::RegExp::kLinear" },
        .{ .name = "RegExp_Flags_kHasIndices", .expr = "v8::RegExp::kHasIndices" },
        .{ .name = "RegExp_Flags_kUnicodeSets", .expr = "v8::RegExp::kUnicodeSets" },
        .{ .name = "SnapshotCreator_FunctionCodeHandling_kClear", .expr = "v8::SnapshotCreator::FunctionCodeHandling::kClear" },
        .{ .name = "SnapshotCreator_FunctionCodeHandling_kKeep", .expr = "v8::SnapshotCreator::FunctionCodeHandling::kKeep" },
        .{ .name = "Isolate_TimeZoneDetection_kSkip", .expr = "v8::Isolate::TimeZoneDetection::kSkip" },
        .{ .name = "Isolate_TimeZoneDetection_kRedetect", .expr = "v8::Isolate::TimeZoneDetection::kRedetect" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageLog", .expr = "v8::Isolate::kMessageLog" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageDebug", .expr = "v8::Isolate::kMessageDebug" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageInfo", .expr = "v8::Isolate::kMessageInfo" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageError", .expr = "v8::Isolate::kMessageError" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageWarning", .expr = "v8::Isolate::kMessageWarning" },
        .{ .name = "Isolate_MessageErrorLevel_kMessageAll", .expr = "v8::Isolate::kMessageAll" },
        .{ .name = "CTypeInfo_Flags_kNone", .expr = "v8::CTypeInfo::Flags::kNone" },
        .{ .name = "CTypeInfo_Flags_kAllowSharedBit", .expr = "v8::CTypeInfo::Flags::kAllowSharedBit" },
        .{ .name = "CTypeInfo_Flags_kEnforceRangeBit", .expr = "v8::CTypeInfo::Flags::kEnforceRangeBit" },
        .{ .name = "CTypeInfo_Flags_kClampBit", .expr = "v8::CTypeInfo::Flags::kClampBit" },
        .{ .name = "CTypeInfo_Flags_kIsRestrictedBit", .expr = "v8::CTypeInfo::Flags::kIsRestrictedBit" },
    },

    // Build options that change the ABI, detected from the macro GN defines
    // (never hard-code these: toggle them with `-Dv8_enable_direct_handle=true`).
    .flags = .{
        .{ .name = "has_webassembly", .define = "V8_ENABLE_WEBASSEMBLY" },
        .{ .name = "is_direct_handle", .define = "V8_ENABLE_DIRECT_HANDLE" },
    },
}
